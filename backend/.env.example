# Live data keys (never commit the real .env)
SERPAPI_KEY=
# Live Google Flights searches the app may make per day (saved fares always work)
SERPAPI_DAILY_LIMIT=20
# Plaid (free Sandbox): https://dashboard.plaid.com -> Developers -> Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# 1 = pitch UI: one Connect button, no environment tags or developer controls
PRESENTATION_MODE=0
# Visa Developer (Sandbox): project -> Credentials -> Two-Way SSL (not your account password)
VISA_USER_ID=
VISA_PASSWORD=
VISA_CERT_PATH=secrets/visa_cert.pem
VISA_KEY_PATH=secrets/visa_private_key.pem
# Cybersource sandbox (Business Center -> Key Management -> REST - Shared Secret)
CYBERSOURCE_MERCHANT_ID=
CYBERSOURCE_KEY_ID=
CYBERSOURCE_SECRET_KEY=
# Gemini (trip parsing from a sentence)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# ElevenLabs voice agent (run: python -m app.ai.voice --setup, then set the agent id)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
